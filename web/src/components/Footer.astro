---
import { getSiteSettings, type SocialLink } from '../lib/strapi';

const settings = await getSiteSettings();

// The icon glyph and brand color for each platform live in code — Strapi
// only decides which platforms are active and where they link to.
const SOCIAL_ICON: Record<SocialLink['platform'], string> = {
  Facebook: 'f',
  X: 'x',
  LinkedIn: 'in',
  Instagram: 'ig',
  WhatsApp: 'wa',
};

const SOCIAL_COLOR: Record<SocialLink['platform'], string> = {
  Facebook: '#1877F2',
  X: '#000000',
  LinkedIn: '#0A66C2',
  Instagram: '#E4405F',
  WhatsApp: '#25D366',
};

const socialLinks = settings?.footerSocialLinks ?? [];
const legalLinks = settings?.footerLegalLinks ?? [];
const copyright = settings?.footerCopyright ?? '© TRINALYZE SRL';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>{copyright}</p>
    <div class="footer-links">
      {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div class="footer-social">
      {socialLinks.map((link) => {
        const isWide = link.platform.length > 1;
        return (
          <a href={link.href} aria-label={link.platform} target="_blank" rel="noopener noreferrer">
            <svg width="38" height="38" viewBox="0 0 38 38" aria-hidden="true">
              <circle cx="19" cy="19" r="19" style={`fill:${SOCIAL_COLOR[link.platform]};`}></circle>
              <text
                x="19"
                y={isWide ? 23.5 : 24.5}
                text-anchor="middle"
                font-family="IBM Plex Mono, monospace"
                font-size={isWide ? 13 : 15}
                font-weight="500"
              >{SOCIAL_ICON[link.platform]}</text>
            </svg>
          </a>
        );
      })}
    </div>
  </div>
</footer>
