---
import type { Post } from '../lib/strapi';
import { CATEGORY_COLOR } from '../lib/ui';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const color = CATEGORY_COLOR[post.category] ?? 'var(--blue)';
---

<a href={`/insights/${post.slug}`} class="insight-card">
  <span
    class="tag"
    style={`background:color-mix(in srgb, ${color} 14%, white); color:${color}; align-self:flex-start;`}
  >
    {post.category}
  </span>
  <h4>{post.title}</h4>
  <p>{post.excerpt}</p>
  <span class="read-more">Leer más &rarr;</span>
</a>
