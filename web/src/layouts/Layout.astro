---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  active: 'inicio' | 'servicios' | 'soluciones' | 'proyectos' | 'equipo' | 'insights' | 'contacto';
}

const {
  title,
  description = 'Consultoría tecnológica, inteligencia artificial, automatización y business intelligence en República Dominicana.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — TRIN∆LYZE</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/logo-official.jpg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <Nav active={active} />
    <slot />
    <Footer />
  </body>
</html>
