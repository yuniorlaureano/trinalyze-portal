---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug } from '../../lib/strapi';
import { CATEGORY_COLOR } from '../../lib/ui';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  Astro.response.status = 404;
}

const color = post ? (CATEGORY_COLOR[post.category] ?? 'var(--blue)') : 'var(--blue)';

const formattedDate = post?.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString('es-DO', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<Layout title={post ? post.title : 'Artículo no encontrado'} active="insights">
  {post ? (
    <>
      <section class="page-header">
        <div class="container">
          <a
            href="/insights"
            style="font-family:var(--font-mono); font-size:12px; color:var(--blue); display:inline-block; margin-bottom:18px;"
          >
            &larr; Volver a Insights
          </a>
          <p class="eyebrow">{post.category}</p>
          <h1>{post.title}</h1>
          {formattedDate && <p class="dek">{formattedDate}</p>}
        </div>
      </section>

      <section class="section">
        <div class="container" style="max-width:70ch;">
          <span class="tag" style={`background:color-mix(in srgb, ${color} 14%, white); color:${color}; margin-bottom:24px; display:inline-block;`}>
            {post.category}
          </span>
          {post.body.split('\n\n').map((paragraph) => (
            <p style="font-size:16.5px; color:var(--ink-soft); margin-bottom:18px; line-height:1.75;">{paragraph}</p>
          ))}
        </div>
      </section>
    </>
  ) : (
    <section class="section" style="text-align:center;">
      <div class="container" style="display:flex; flex-direction:column; align-items:center; gap:14px;">
        <p class="eyebrow">404</p>
        <h1 style="font-size:28px;">No encontramos este artículo.</h1>
        <p class="dek">Puede que se haya movido, renombrado o despublicado.</p>
        <a href="/insights" class="btn btn-primary" style="margin-top:10px;">Volver a Insights</a>
      </div>
    </section>
  )}
</Layout>
