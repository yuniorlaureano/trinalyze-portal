---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Contacto" active="contacto">
  <section class="section" style="padding-top:64px;">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Contacto</p>
        <h1 style="font-size:32px; font-weight:700; margin-top:10px; max-width:16ch;">Solicitar diagnóstico</h1>
        <p style="font-size:15.5px; color:var(--ink-soft); margin-top:16px; max-width:42ch;">
          Cuéntanos qué proceso o decisión quieres mejorar.
          <strong style="color:var(--ink);"
            >Uno de nuestros representantes se pondrá en contacto contigo de inmediato, en los
            próximos 5 minutos.</strong
          >
        </p>
        <a
          href="#"
          style="display:inline-flex; align-items:center; gap:9px; margin-top:26px; font-weight:600; font-size:14.5px; color:var(--ink);"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--mint)" stroke-width="2" aria-hidden="true">
            <path
              d="M20.5 3.5a11 11 0 0 0-17.4 13.2L2 21l4.5-1.1A11 11 0 1 0 20.5 3.5Z"
            ></path>
            <path
              d="M8.5 8.7c.3-.6.6-.6 1-.6h.7c.2 0 .5 0 .7.5l.8 1.9c.1.3.1.5-.1.8l-.6.7c-.2.2-.2.4-.1.7.5 1 1.6 2.1 2.6 2.6.3.1.5.1.7-.1l.7-.6c.3-.2.5-.2.8-.1l1.9.8c.5.2.5.5.5.7v.7c0 .4 0 .7-.6 1-1 .5-2.6.5-4.4-.4-1.8-.9-3.5-2.6-4.4-4.4-.9-1.8-.9-3.4-.4-4.4Z"
            ></path>
          </svg>
          Escríbenos por WhatsApp (RD +1 809)
        </a>
        <div style="display:flex; gap:10px; margin-top:44px; flex-wrap:wrap;">
          <a href="/" style="font-size:13px; color:var(--ink-faint);">Inicio</a>
          <span style="color:var(--line);">·</span>
          <a href="/servicios" style="font-size:13px; color:var(--ink-faint);">Servicios</a>
          <span style="color:var(--line);">·</span>
          <a href="/proyectos" style="font-size:13px; color:var(--ink-faint);">Proyectos</a>
          <span style="color:var(--line);">·</span>
          <a href="/insights" style="font-size:13px; color:var(--ink-faint);">Insights</a>
        </div>
        <p style="font-size:13px; color:var(--ink-faint); margin-top:44px;">
          Con sede en Santo Domingo, República Dominicana.
        </p>
      </div>

      <ContactForm client:load />
    </div>
  </section>
</Layout>
