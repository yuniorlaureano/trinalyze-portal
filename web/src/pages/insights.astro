---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getInsightsPage, getPostsPage } from '../lib/strapi';
import { CATEGORY_LABEL, POST_CATEGORIES } from '../lib/ui';

const PAGE_SIZE = 6;

const requestedCategory = Astro.url.searchParams.get('category');
const category = requestedCategory && (POST_CATEGORIES as readonly string[]).includes(requestedCategory)
  ? requestedCategory
  : null;

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const [insightsPage, postsPage] = await Promise.all([
  getInsightsPage(),
  getPostsPage({ category: category ?? undefined, page, pageSize: PAGE_SIZE }),
]);

if (!insightsPage) {
  throw new Error('Insights Page content is missing in Strapi.');
}

function hrefFor(targetCategory: string | null, targetPage: number): string {
  const params = new URLSearchParams();
  if (targetCategory) params.set('category', targetCategory);
  if (targetPage > 1) params.set('page', String(targetPage));
  const qs = params.toString();
  return qs ? `/insights?${qs}` : '/insights';
}

const { posts, pageCount, total } = postsPage;
const pageNumbers = Array.from({ length: pageCount }, (_, i) => i + 1);
---

<Layout title="Insights" active="insights">
  <section class="page-header">
    <div class="container">
      {insightsPage.header?.eyebrow && <p class="eyebrow">{insightsPage.header.eyebrow}</p>}
      <h1>{insightsPage.header?.heading ?? 'Insights'}</h1>
      {insightsPage.header?.dek && <p class="dek">{insightsPage.header.dek}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-row">
        <a href={hrefFor(null, 1)} class={`filter-chip ${!category ? 'active' : ''}`}>Todos</a>
        {POST_CATEGORIES.map((cat) => (
          <a href={hrefFor(cat, 1)} class={`filter-chip ${category === cat ? 'active' : ''}`}>
            {CATEGORY_LABEL[cat]}
          </a>
        ))}
      </div>

      {posts.length > 0 ? (
        <div class="grid-3" style="margin-top:32px;">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p style="margin-top:32px; color:var(--ink-faint); font-size:15px;">
          Todavía no hay artículos en esta categoría.
        </p>
      )}

      {pageCount > 1 && (
        <div class="pagination">
          {page > 1 ? (
            <a href={hrefFor(category, page - 1)}>&larr; Anterior</a>
          ) : (
            <span class="disabled">&larr; Anterior</span>
          )}
          {pageNumbers.map((n) => (
            <a href={hrefFor(category, n)} class={n === page ? 'active' : ''}>{n}</a>
          ))}
          {page < pageCount ? (
            <a href={hrefFor(category, page + 1)}>Siguiente &rarr;</a>
          ) : (
            <span class="disabled">Siguiente &rarr;</span>
          )}
        </div>
      )}

      <p style="font-family:var(--font-mono); font-size:11.5px; color:var(--ink-faint); margin-top:24px;">
        {total} artículo{total === 1 ? '' : 's'} · Titulares ilustrativos — se conectan a artículos reales del blog una vez publicado.
      </p>
    </div>
  </section>
</Layout>
