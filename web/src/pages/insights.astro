---
import Layout from '../layouts/Layout.astro';
import { getInsightsPage, getPosts } from '../lib/strapi';

const [page, posts] = await Promise.all([getInsightsPage(), getPosts()]);

if (!page) {
  throw new Error('Insights Page content is missing in Strapi.');
}

const CATEGORY_COLOR: Record<string, string> = {
  IA: 'var(--mint)',
  BI: 'var(--blue)',
  Automatizacion: 'var(--mint)',
  Data: 'var(--blue)',
};
---

<Layout title="Insights" active="insights">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">{page.header.eyebrow}</p>
      <h1>{page.header.heading}</h1>
      {page.header.dek && <p class="dek">{page.header.dek}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {posts.map((post) => {
          const color = CATEGORY_COLOR[post.category] ?? 'var(--blue)';
          return (
            <a href="/insights" class="insight-card">
              <span
                class="tag"
                style={`background:color-mix(in srgb, ${color} 14%, white); color:${color}; align-self:flex-start;`}
              >
                {post.category}
              </span>
              <h4>{post.title}</h4>
              <p>{post.excerpt}</p>
              <span class="read-more">Leer más &rarr;</span>
            </a>
          );
        })}
      </div>
      <p style="font-family:var(--font-mono); font-size:11.5px; color:var(--ink-faint); margin-top:24px;">
        Titulares ilustrativos — se conectan a artículos reales del blog una vez publicado.
      </p>
    </div>
  </section>
</Layout>
