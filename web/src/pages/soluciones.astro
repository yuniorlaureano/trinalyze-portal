---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getSolucionesPage, getSectors } from '../lib/strapi';

const [page, sectors] = await Promise.all([getSolucionesPage(), getSectors()]);

if (!page) {
  throw new Error('Soluciones Page content is missing in Strapi.');
}

const PHASE_COLOR = ['var(--ink-faint)', 'var(--ink-faint)', 'var(--blue)', 'var(--blue)', 'var(--mint)'];
---

<Layout title="Soluciones" active="soluciones">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">{page.header.eyebrow}</p>
      <h1>{page.header.heading}</h1>
      {page.header.dek && <p class="dek">{page.header.dek}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="process-row" style="margin-top:0;">
        {page.phases.map((phase, i) => (
          <div class="process-step" style={i === page.phases.length - 1 ? 'border-right:none; margin-right:0;' : ''}>
            <div class="step-label">
              <svg width="12" height="12" viewBox="0 0 100 100" aria-hidden="true">
                <polygon
                  points="50,10 10,85 90,85"
                  fill="none"
                  stroke={PHASE_COLOR[i] ?? 'var(--ink-faint)'}
                  stroke-width="10"></polygon>
              </svg>
              <span>FASE {phase.numeral}</span>
            </div>
            <h4>{phase.title}</h4>
            <p class="question">{phase.question}</p>
            <p class="detail">{phase.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sectors-band">
    <div class="container">
      <p class="eyebrow">Sectores</p>
      <h2>Trabajamos donde los datos mueven la operación.</h2>
      <div class="chip-row">
        {sectors.map((sector) => <span class="chip">{sector.name}</span>)}
      </div>
    </div>
  </section>

  <CtaBand cta={page.ctaFinal} variant="ghost" />
</Layout>
