---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { getServiciosPage, getServices } from '../lib/strapi';
import { PILLAR_ICON } from '../lib/ui';

const [page, services] = await Promise.all([getServiciosPage(), getServices()]);

if (!page) {
  throw new Error('Servicios Page content is missing in Strapi.');
}
---

<Layout title="Servicios" active="servicios">
  <section class="page-header">
    <div class="container">
      {page.header?.eyebrow && <p class="eyebrow">{page.header.eyebrow}</p>}
      <h1>{page.header?.heading ?? 'Servicios'}</h1>
      {page.header?.dek && <p class="dek">{page.header.dek}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:flex; flex-direction:column; gap:64px;">
      {services.map((service) => {
        const icon = PILLAR_ICON[service.pillar] ?? PILLAR_ICON['Technology'];
        return (
          <div class="grid-2" style="grid-template-columns: 0.55fr 1fr;">
            <div>
              <svg
                width="30"
                height="30"
                viewBox="0 0 24 24"
                fill="none"
                stroke={icon.color}
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icon.path}
              />
              <h2 style="font-size:26px; font-weight:700; margin-top:14px;">{service.title}</h2>
              <p style="font-size:15px; color:var(--ink-soft); margin-top:12px; max-width:38ch;">
                {service.description}
              </p>
            </div>
            <ul style="margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:14px;">
              {(service.highlights ?? []).map((item) => (
                <li style="border-top:1px solid var(--line); padding-top:14px; font-size:15px; color:var(--ink);">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <CtaBand cta={page.ctaFinal} />
</Layout>
