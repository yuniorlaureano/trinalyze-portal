---
import Layout from '../layouts/Layout.astro';
import { getEquipoPage, getTeamMembers } from '../lib/strapi';

const [page, team] = await Promise.all([getEquipoPage(), getTeamMembers()]);

if (!page) {
  throw new Error('Equipo Page content is missing in Strapi.');
}

const GRADIENTS = [
  ['#6FA0FF', '#2E67D8'],
  ['#5FE0C6', '#22B39B'],
  ['#8FB6FF', '#4C7FE0'],
  ['#E0A24F', '#B0402F'],
  ['#7FE6C9', '#1D8E82'],
];
---

<Layout title="Equipo" active="equipo">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">{page.header.eyebrow}</p>
      <h1>{page.header.heading}</h1>
      {page.header.dek && <p class="dek">{page.header.dek}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-5">
        {team.map((member, i) => {
          const [c1, c2] = GRADIENTS[i % GRADIENTS.length];
          return (
            <div>
              <div class="team-avatar" style={`background:linear-gradient(135deg, ${c1} 0%, ${c2} 100%);`}>
                <span>{member.initials}</span>
              </div>
              <p style="font-size:15px; font-weight:600; margin-top:10px;">{member.direction}</p>
              <p style="font-size:13px; color:var(--ink-faint); margin-top:2px;">{member.roleSummary}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--alt section--divider-top">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Filosofía</p>
        <h2 style="font-size:27px; font-weight:700; margin-top:10px;">{page.filosofia.heading}</h2>
      </div>
      <div style="display:flex; flex-direction:column; gap:14px;">
        {page.filosofia.body.split('\n\n').map((paragraph) => (
          <p style="font-size:16px; color:var(--ink-soft); max-width:58ch;">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>
</Layout>
