---
import Layout from '../layouts/Layout.astro';
import { getTeamMembers, getAboutPage } from '../lib/strapi';

const [team, about] = await Promise.all([getTeamMembers(), getAboutPage()]);

const GRADIENTS = [
  ['#6FA0FF', '#2E67D8'],
  ['#5FE0C6', '#22B39B'],
  ['#8FB6FF', '#4C7FE0'],
  ['#E0A24F', '#B0402F'],
  ['#7FE6C9', '#1D8E82'],
];
---

<Layout title="Equipo" active="equipo">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Nuestro equipo</p>
      <h1>CEO + {Math.max(team.length - 1, 4)} socios, cada uno al frente de una dirección.</h1>
      <p class="dek">
        Un modelo matricial orientado a proyectos: cada dirección aporta su especialidad, y los
        equipos se arman según lo que cada iniciativa realmente necesita.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-5">
        {team.map((member, i) => {
          const [c1, c2] = GRADIENTS[i % GRADIENTS.length];
          return (
            <div>
              <div class="team-avatar" style={`background:linear-gradient(135deg, ${c1} 0%, ${c2} 100%);`}>
                <span>{member.initials}</span>
              </div>
              <p style="font-size:15px; font-weight:600; margin-top:10px;">{member.direction}</p>
              <p style="font-size:13px; color:var(--ink-faint); margin-top:2px;">{member.roleSummary}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {about?.filosofiaHeading && (
    <section class="section section--alt section--divider-top">
      <div class="container grid-2">
        <div>
          <p class="eyebrow">Filosofía</p>
          <h2 style="font-size:27px; font-weight:700; margin-top:10px;">{about.filosofiaHeading}</h2>
        </div>
        <div style="display:flex; flex-direction:column; gap:14px;">
          {(about.filosofiaBody ?? '').split('\n\n').map((paragraph) => (
            <p style="font-size:16px; color:var(--ink-soft); max-width:58ch;">{paragraph}</p>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
