# Server-side only — used in .astro frontmatter fetches
STRAPI_URL=http://localhost:1337

# Exposed to the browser — used by the contact form island to POST directly to Strapi
PUBLIC_STRAPI_URL=http://localhost:1337

# Shared secret Strapi's webhook sends so /api/revalidate can't be triggered
# by randoms. Leave unset locally (the endpoint skips the check); set it in
# production and configure the same value on Strapi's webhook. See DEPLOY.md.
REVALIDATE_SECRET=
