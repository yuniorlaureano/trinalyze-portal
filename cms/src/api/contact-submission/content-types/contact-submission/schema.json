{
  "kind": "collectionType",
  "collectionName": "contact_submissions",
  "info": {
    "singularName": "contact-submission",
    "pluralName": "contact-submissions",
    "displayName": "Contact Submission",
    "description": "Entry sent from the 'Solicitar diagnostico' form"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Optional — lets the team follow up by call/WhatsApp within the 5-minute promise"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "handled": {
      "type": "boolean",
      "default": false,
      "description": "Marked true once someone from the team has followed up"
    }
  }
}
