# Reverse proxy config for the VPS.
#
# No domain yet: each service is reachable by port on the VPS's IP.
#   http://<VPS_IP>        -> the Astro site
#   http://<VPS_IP>:1337   -> Strapi (admin panel + API)
#
# Once a domain is pointed at the VPS, replace ":80" and ":1337" below
# with named-host blocks and Caddy will fetch HTTPS certificates
# automatically — no other config changes needed. For example, keep the
# "root"/"@static"/"handle" lines from the :80 block as they are, just
# rename ":80" to "trinalyze.com":
#
#   trinalyze.com {
#     root * /srv/static
#     @static { path /assets/* /styles/* /_astro/* /favicon.ico /favicon.svg /robots.txt }
#     handle @static {
#       header Cache-Control "public, max-age=3600"
#       file_server
#     }
#     handle {
#       reverse_proxy web:4321
#     }
#   }
#
#   cms.trinalyze.com {
#     reverse_proxy cms:1337
#   }
#
# After switching to domain blocks, also update PUBLIC_STRAPI_URL in your
# .env to the new https://cms.trinalyze.com address and rebuild the web
# image (see DEPLOY.md) — that value is baked in at build time.

:80 {
	# Static files (logo, CSS, favicons, Astro's hashed JS/CSS chunks) are
	# served straight from the shared web_static volume instead of being
	# proxied through Node — keeps the single Node process free to do SSR
	# rendering, instead of queuing image/CSS requests behind it.
	root * /srv/static

	@static {
		path /assets/* /styles/* /_astro/* /favicon.ico /favicon.svg /robots.txt
	}
	handle @static {
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		reverse_proxy web:4321
	}
}

:1337 {
	reverse_proxy cms:1337
}
