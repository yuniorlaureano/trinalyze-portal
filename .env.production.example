# Copy this file to `.env` next to docker-compose.prod.yml on the VPS,
# then fill in real values. Never commit the real `.env` — it holds
# production secrets. See DEPLOY.md for how to generate the secrets below.

# ---- Database ----
DATABASE_NAME=trinalyze
DATABASE_USERNAME=trinalyze
DATABASE_PASSWORD=replace-with-a-strong-password

# ---- Strapi secrets (generate fresh ones for production — see DEPLOY.md) ----
APP_KEYS=replace,with,four,comma,separated,keys
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# ---- Frontend ----
# Where the visitor's browser reaches Strapi directly (the contact form
# posts here from the client). No domain yet, so use the VPS's public IP
# and Strapi's exposed port. Update this once you have a domain — see the
# Caddyfile comments — and rebuild the web image after changing it.
PUBLIC_STRAPI_URL=http://YOUR_VPS_IP:1337
